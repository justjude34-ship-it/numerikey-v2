<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f0e14">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Lantern">
<title>Lantern</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0f0e14; --surface:#17151f; --elev:#1e1b2a;
  --fg:#f4efe8; --muted:#b7b0c4; --faint:#8a8298;
  --line:rgba(196,184,230,.16);
  --teal:#7ee0d6; --purple:#a78bfa; --gold:#e7d7b1;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--fg)}
body{font-family:Outfit,system-ui,sans-serif;line-height:1.5;padding-bottom:calc(84px + env(safe-area-inset-bottom))}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
img{display:block;max-width:100%}
.wrap{max-width:680px;margin:0 auto}
.hero{position:relative;height:38vh;min-height:220px;max-height:420px;overflow:hidden;background:#0a0810}
.hero img{width:100%;height:100%;object-fit:cover;object-position:center 62%}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to top, #0f0e14 0%, rgba(15,14,20,.15) 42%, rgba(15,14,20,.25) 100%);pointer-events:none}
.intro{padding:4px 20px 8px}
h1{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:2.4rem;margin:0;letter-spacing:-.02em;color:#f7f1e8}
.tag{margin:.35rem 0 0;color:var(--muted);font-size:.98rem}
.kicker{color:var(--teal);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;margin:0 0 .35rem}
.card{margin:14px 16px;background:linear-gradient(180deg,rgba(255,255,255,.03),transparent 40%),var(--surface);border:1px solid var(--line);border-radius:22px;padding:16px;overflow:hidden}
.card h2{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:1.45rem;margin:0 0 .35rem}
.card p{margin:.35rem 0;color:var(--muted)}
.shot{width:100%;height:180px;object-fit:cover;object-position:center 55%;border-radius:16px;margin-bottom:12px}
.tools{display:grid;gap:10px;padding:6px 16px 10px}
.tool{display:flex;gap:12px;align-items:center;text-align:left;width:100%;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:12px;color:var(--fg);cursor:pointer}
.tool b{display:block;font-weight:600}
.tool span{color:var(--muted);font-size:.88rem}
.dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:#0c0b12;border-top:1px solid var(--line);padding:6px 4px calc(6px + env(safe-area-inset-bottom));z-index:5}
nav label{flex:1;text-align:center;color:var(--faint);font-size:.72rem;font-weight:600;padding:8px 2px;border-radius:12px;cursor:pointer}
nav label i{display:block;height:6px;margin-bottom:4px}
.view{display:none}
input.tab{position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;padding:0;border:0;background:transparent}
#tab-home:checked ~ #view-home,
#tab-assess:checked ~ #view-assess,
#tab-ground:checked ~ #view-ground,
#tab-safety:checked ~ #view-safety,
#tab-help:checked ~ #view-help{display:block}
#tab-home:checked ~ nav label[for="tab-home"],
#tab-assess:checked ~ nav label[for="tab-assess"],
#tab-ground:checked ~ nav label[for="tab-ground"],
#tab-safety:checked ~ nav label[for="tab-safety"],
#tab-help:checked ~ nav label[for="tab-help"]{color:var(--fg)}
#tab-home:checked ~ nav label[for="tab-home"] i,
#tab-assess:checked ~ nav label[for="tab-assess"] i,
